# --- Database (Turso). Website: use a READ-ONLY token. Pipeline: a full-access token. ---
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# --- Pipeline only ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_INTERVAL_MS=7000        # spacing between calls; free tier is ~10 requests/minute

FORECASTS_PER_DAY_MIN=3
FORECASTS_PER_DAY_MAX=5
# DISABLED_CATEGORIES=Public Health   # comma-separated; pauses drafting in a category

RESOLUTION_MODE=auto               # auto: high-confidence YES/NO with evidence applies itself. review: everything queues.
EARLY_CHECKS_PER_RUN=4
MARKET_DEADLINE_TOLERANCE_DAYS=3
VOID_GUARD_WINDOW=20
VOID_GUARD_MAX_RATE=0.2
